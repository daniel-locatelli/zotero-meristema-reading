{
  "name": "zotero-meristema-reading",
  "version": "0.0.0",
  "private": true,
  "description": "Ordered reading lists for Zotero, with read state kept per paper.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:check": "prettier --check .",
