    "check": "npm run lint:check && npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/node": "^26.2.0",
    "chai": "^6.2.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11.18"
  }
}
